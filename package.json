{
  "name": "@mohadjillani/api-mock-server",
  "version": "0.1.0",
  "description": "Turn an OpenAPI 3 spec into a running mock server with seeded deterministic data, real CRUD semantics, response validation against the contract, and chaos scenarios for testing the bad days.",
  "author": "Mohad Jillani <mohad.jillani@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohadjillani/api-mock-server.git"
  },
  "homepage": "https://github.com/mohadjillani/api-mock-server#readme",
  "bugs": "https://github.com/mohadjillani/api-mock-server/issues",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "apimock": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "openapi",
    "mock",
    "mock-server",
    "api",
    "testing",
    "chaos",
    "swagger"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.0.0",
    "@faker-js/faker": "^10.1.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^14.0.2",
    "express": "^5.2.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "supertest": "^7.1.4",
    "tsup": "^8.5.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^3.2.7"
  }
}
